generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH & ADMIN
// ==========================================

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// SITE SETTINGS
// ==========================================

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  group String @default("general")
}

// ==========================================
// DOCTOR PROFILE
// ==========================================

model DoctorProfile {
  id           String  @id @default(cuid())
  locale       String  @default("az")
  name         String  @default("")
  title        String  @default("")
  subtitle     String  @default("")
  bio          String  @default("")
  education    String  @default("")
  experience   String  @default("")
  certificates String  @default("")
  conferences  String  @default("")
  trainings    String  @default("")
  achievements String  @default("")
  approach     String  @default("")
  photoUrl     String  @default("")
  aboutPhotoUrl String @default("")
  phone        String  @default("")
  whatsapp     String  @default("")
  email        String  @default("")
  address      String  @default("")
  addressLine2 String  @default("")
  city         String  @default("")
  lat          Float?
  lng          Float?
  mapsUrl      String  @default("")
  mapsEmbed    String  @default("")
  instagram    String  @default("")
  tiktok       String  @default("")
  youtube      String  @default("")
  facebook     String  @default("")
  telegram     String  @default("")
  website      String  @default("")
  workingHours String  @default("")

  @@unique([locale])
}

// ==========================================
// SERVICES
// ==========================================

model Service {
  id                  String        @id @default(cuid())
  locale              String        @default("az")
  slug                String
  title               String
  shortDescription    String        @default("")
  description         String        @default("")
  symptoms            String        @default("")
  whoShouldApply      String        @default("")
  examinationProcess  String        @default("")
  treatmentApproach   String        @default("")
  icon                String        @default("")
  coverImage          String        @default("")
  order               Int           @default(0)
  isActive            Boolean       @default(true)
  seoTitle            String        @default("")
  seoDescription      String        @default("")
  seoKeywords         String        @default("")
  ogImage             String        @default("")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  appointments        Appointment[]

  @@unique([locale, slug])
}

// ==========================================
// TREATMENT AREAS (Müalicə istiqamətləri)
// ==========================================

model TreatmentArea {
  id              String   @id @default(cuid())
  locale          String   @default("az")
  slug            String
  title           String
  description     String   @default("")
  icon            String   @default("")
  coverImage      String   @default("")
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  seoTitle        String   @default("")
  seoDescription  String   @default("")
  seoKeywords     String   @default("")
  ogImage         String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([locale, slug])
}

// ==========================================
// LOCATIONS (Rayonlar)
// ==========================================

model Location {
  id                String        @id @default(cuid())
  locale            String        @default("az")
  slug              String
  name              String
  address           String        @default("")
  phone             String        @default("")
  lat               Float?
  lng               Float?
  mapsUrl           String        @default("")
  mapsEmbed         String        @default("")
  appointmentStatus String        @default("active")
  description       String        @default("")
  order             Int           @default(0)
  isActive          Boolean       @default(true)
  seoTitle          String        @default("")
  seoDescription    String        @default("")
  seoKeywords       String        @default("")
  ogImage           String        @default("")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  schedules         Schedule[]
  specialDays       SpecialDay[]
  appointments      Appointment[]

  @@unique([locale, slug])
}

// ==========================================
// SCHEDULE & CALENDAR
// ==========================================

model Schedule {
  id           String   @id @default(cuid())
  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek    Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime    String   // "09:00"
  endTime      String   // "18:00"
  breakStart   String   @default("")  // "13:00"
  breakEnd     String   @default("")  // "14:00"
  slotDuration Int      @default(30)  // minutes
  isActive     Boolean  @default(true)
}

model SpecialDay {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date       String   // "2024-01-15"
  isOff      Boolean  @default(true)
  startTime  String   @default("")
  endTime    String   @default("")
  note       String   @default("")
}

// ==========================================
// APPOINTMENTS (Rezervasiyalar)
// ==========================================

model Appointment {
  id         String   @id @default(cuid())
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  date       String   // "2024-01-15"
  time       String   // "10:00"
  firstName  String
  lastName   String
  phone      String
  email      String   @default("")
  notes      String   @default("")
  status     String   @default("new") // new, confirmed, waiting, cancelled, completed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// BLOG
// ==========================================

model BlogCategory {
  id     String     @id @default(cuid())
  locale String     @default("az")
  slug   String
  name   String
  order  Int        @default(0)
  posts  BlogPost[]

  @@unique([locale, slug])
}

model BlogPost {
  id              String        @id @default(cuid())
  locale          String        @default("az")
  slug            String
  title           String
  content         String        @default("")
  excerpt         String        @default("")
  coverImage      String        @default("")
  author          String        @default("")
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  readTime        Int           @default(5) // minutes
  isPublished     Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  publishedAt     DateTime?
  seoTitle        String        @default("")
  seoDescription  String        @default("")
  seoKeywords     String        @default("")
  ogImage         String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([locale, slug])
}

// ==========================================
// VIDEOS
// ==========================================

model Video {
  id          String   @id @default(cuid())
  youtubeId   String
  title       String
  description String   @default("")
  thumbnail   String   @default("")
  category    String   @default("")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ==========================================
// FAQ
// ==========================================

model FAQ {
  id       String  @id @default(cuid())
  locale   String  @default("az")
  question String
  answer   String
  category String  @default("general")
  pageSlug String  @default("") // which page this FAQ belongs to
  order    Int     @default(0)
  isActive Boolean @default(true)
}

// ==========================================
// SOCIAL MEDIA POSTS
// ==========================================

model SocialPost {
  id       String  @id @default(cuid())
  platform String  // "instagram", "tiktok"
  imageUrl String  @default("")
  postUrl  String  @default("")
  caption  String  @default("")
  order    Int     @default(0)
  isActive Boolean @default(true)
}

// ==========================================
// SEO SETTINGS (per-page)
// ==========================================

model SEOSetting {
  id            String @id @default(cuid())
  locale        String @default("az")
  pageSlug      String // "home", "about", "services", etc.
  title         String @default("")
  description   String @default("")
  keywords      String @default("")
  ogTitle       String @default("")
  ogDescription String @default("")
  ogImage       String @default("")
  canonical     String @default("")

  @@unique([locale, pageSlug])
}

// ==========================================
// CONTACT MESSAGES
// ==========================================

model ContactMessage {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  email     String   @default("")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
